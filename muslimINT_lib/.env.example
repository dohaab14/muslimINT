# MuslimINT - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs

# Clé secrète Django (générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=changez-moi-en-production

# Mode debug (False en production !)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Email (production uniquement) =====
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre-email@gmail.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-app
# DEFAULT_FROM_EMAIL=noreply@muslimint.fr
